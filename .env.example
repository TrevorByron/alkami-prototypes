# Public Supabase browser configuration. Set these in local .env or GitLab CI
# variables; never commit real values to the repository.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ALLOWED_EMAIL_DOMAIN=alkami.com
VITE_SLACK_NOTIFICATIONS_ENABLED=false

# Local-only browser demo mode. Never set this in GitLab CI or production.
# VITE_DEV_AUTH_BYPASS=true

# Server-only values belong in Supabase Vault / Edge Function secrets.
# ALLOWED_EMAIL_DOMAIN=alkami.com
# ALLOWED_SLACK_TEAM_ID=
# APP_ORIGIN=
# APP_URL=
# SLACK_BOT_TOKEN=

# GitLab CI variables used by the manual Edge Function deploy job:
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=
